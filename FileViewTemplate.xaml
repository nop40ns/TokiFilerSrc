<ResourceDictionary
    x:Class="TokiFiler.UserControls.Templates.FileViewTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bv="clr-namespace:TokiFiler.Behavior"
    xmlns:cc="clr-namespace:TokiFiler.CustomControl"
    xmlns:conv="clr-namespace:TokiFiler.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <DataTemplate x:Key="FileDetailTemplate">
        <DataTemplate.Resources>
            <!--  テンプレート専用のコンバーター  -->
            <conv:GridLengthConverter x:Key="GridLengthConverter" />
        </DataTemplate.Resources>


        <Grid
            HorizontalAlignment="Left"
            Background="Transparent"
            IsHitTestVisible="True">



            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding DataContext.NameColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
                <ColumnDefinition Width="{Binding DataContext.DateColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
                <ColumnDefinition Width="{Binding DataContext.TypeColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
                <ColumnDefinition Width="{Binding DataContext.SizeColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
            </Grid.ColumnDefinitions>

            <!--  名前列  -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Model.IsChecked, TargetNullValue=False, Mode=TwoWay}"
                    IsHitTestVisible="True">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <!--  通常は透明にしておく  -->
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>



                                <!--  マウスが行(ListBoxItem)の上にあるか、チェック済みの時は表示  -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>

                                <!--  IsSelectable が False の時は、強制的に選択不可＆見た目を通常にする  -->
                                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Setter Property="Opacity" Value="0" />
                                    <!--  ダブルクリックは通したいのでTrue  -->
                                </DataTrigger>


                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>


                <Image
                    Grid.Column="1"
                    Width="24"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Source="{Binding IconSource}"
                    Stretch="Uniform" />


                <!--<TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    IsHitTestVisible="True"
                    Text="{Binding FileName}"
                    TextTrimming="CharacterEllipsis">

                    <i:Interaction.Behaviors>
                        <bv:ExplorerClickRenameBehavior />
                    </i:Interaction.Behaviors>

                </TextBlock>-->


                <cc:EditableTextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AllowDrop="True"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    EditedText="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    IsEditing="{Binding Model.IsEditing, Mode=TwoWay}"
                    Placement="Relative"
                    PreviewTextInputChecker="{Binding OnCheckPreviewInput}"
                    Text="{Binding FileName, Mode=OneWay}"
                    TextChanging="{Binding OnCheckPreviewText}"
                    TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                    TextTrimming="CharacterEllipsis" />







                <!--  編集時：TextBoxを表示  -->
                <!--

                <TextBox
                    x:Name="EditTextBox"
                    Grid.Column="2"
                    Background="#FFFFFF"
                    FocusManager.IsFocusScope="True"
                    Focusable="True"
                    Foreground="Green"
                    IsVisibleChanged="EditTextBox_IsVisibleChanged"
                    KeyDown="EditTextBox_KeyDown"
                    Loaded="EditTextBox_Loaded"
                    LostFocus="EditTextBox_LostFocus"
                    PreviewTextInput="EditTextBox_PreviewTextInput"
                    Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Popup
                    AllowsTransparency="True"
                    IsOpen="{Binding HasError}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=EditTextBox}"
                    StaysOpen="False">
                    <Border
                        Padding="5"
                        Background="#FFFEEB"
                        BorderBrush="Orange"
                        BorderThickness="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="#333"
                            Text="{Binding ErrorMessage}" />
                    </Border>
                </Popup>-->
            </Grid>

            <!--  更新日時  -->
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding LastWriteDateTime}"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis" />

            <!--  種類  -->
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding FileType}"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis" />

            <!--  サイズ  -->
            <TextBlock
                Grid.Column="3"
                Padding="0,0,10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding FormattedSize}"
                TextAlignment="Right"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FileLargeIconTemplate">
        <Grid
            Width="100"
            Margin="10"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />

                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CheckBox
                Grid.Row="0"
                Margin="4,0,8,0"
                VerticalAlignment="Top"
                IsChecked="{Binding Model.IsChecked, TargetNullValue=False, Mode=TwoWay}"
                IsHitTestVisible="True">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <!--  通常は透明にしておく  -->
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>



                            <!--  マウスが行(ListBoxItem)の上にあるか、チェック済みの時は表示  -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>

                            <!--  IsSelectable が False の時は、強制的に選択不可＆見た目を通常にする  -->
                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Opacity" Value="0" />
                                <!--  ダブルクリックは通したいのでTrue  -->
                            </DataTrigger>


                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
            <Image
                Grid.Row="0"
                Height="64"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Source="{Binding IconSource}" />

            <!--<TextBlock
                Width="90"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding FileName}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />-->
            <cc:EditableTextBlock
                Grid.Row="1"
                Width="90"
                Height="50"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AllowDrop="True"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Text="{Binding FileName, Mode=OneWay}"
                TextAlignment="Center"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />



        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FileContantTemplate">
        <DataTemplate.Resources>
            <!--  テンプレート専用のコンバーター  -->
            <conv:GridLengthConverter x:Key="GridLengthConverter" />

        </DataTemplate.Resources>

        <Grid HorizontalAlignment="Stretch" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="64" />

                <ColumnDefinition Width="{Binding DataContext.NameColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
                <ColumnDefinition Width="{Binding DataContext.DateColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <CheckBox
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding Model.IsChecked, TargetNullValue=False, Mode=TwoWay}"
                IsHitTestVisible="True">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <!--  通常は透明にしておく  -->
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>



                            <!--  マウスが行(ListBoxItem)の上にあるか、チェック済みの時は表示  -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>

                            <!--  IsSelectable が False の時は、強制的に選択不可＆見た目を通常にする  -->
                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Opacity" Value="0" />
                                <!--  ダブルクリックは通したいのでTrue  -->
                            </DataTrigger>


                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
            <Image
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="64"
                Height="64"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="{Binding IconSource}" />

            <cc:EditableTextBlock
                Grid.Row="0"
                Grid.Column="2"
                Margin="20,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AllowDrop="True"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding FileName, Mode=OneWay}"
                TextAlignment="Left"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis" />

            <!--  種類  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                Margin="20,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding FileType}"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis" />

            <!--  更新日時  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding LastWriteDateTime, StringFormat='yyyy/MM/dd HH:mm:ss'}"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis" />


            <!--  サイズ  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                IsHitTestVisible="False"
                Text="{Binding FormattedSize}"
                TextAlignment="Right"
                TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                TextTrimming="CharacterEllipsis" />



        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FileThumbnailTemplate">
        <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <CheckBox
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsChecked="{Binding Model.IsChecked, TargetNullValue=False, Mode=TwoWay}"
                    IsHitTestVisible="True">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <!--  通常は透明にしておく  -->
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>



                                <!--  マウスが行(ListBoxItem)の上にあるか、チェック済みの時は表示  -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>

                                <!--  IsSelectable が False の時は、強制的に選択不可＆見た目を通常にする  -->
                                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Setter Property="Opacity" Value="0" />
                                    <!--  ダブルクリックは通したいのでTrue  -->
                                </DataTrigger>


                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <Image
                    Grid.Row="1"
                    Width="256"
                    Height="256"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Source="{Binding IconSource}" />

                <!--<TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    IsHitTestVisible="False"
                    Text="{Binding FileName}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />-->

                <cc:EditableTextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AllowDrop="True"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Text="{Binding FileName, Mode=OneWay}"
                    TextDecorations="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(TextBlock.TextDecorations)}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />

            </Grid>


        </Grid>
    </DataTemplate>




</ResourceDictionary>